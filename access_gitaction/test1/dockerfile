FROM openeuler/openeuler:20.03-lts


ENV LANG en_US.utf8

RUN set -eux; \
    yum install -y lz4 lz4-devel bzip2 bzip2-devel curl libaio python3 python3-devel python python-devel openssl-devel gcc-c++ make hostname iproute dos2unix libedit-devel binutils --nogpgcheck && \
    mkdir -p /usr1/build/workspace/ && \
    groupadd tester2 && useradd -g tester2 -m tester2 && \
    ln -s /usr/lib/dkms/lsb_release /usr/bin/lsb_release && \
    mkdir /usr1/build/workspace/dependency && \
    mkdir -p /data/om/ && mkdir -p /data/om/result/ && mkdir -p /data/om/result2/ && \
    localedef -c -i zh_CN -f GBK zh_CN.GBK && \
    touch /usr1/build/workspace/build.log
    

COPY entrypoint.sh /usr/local/bin/

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

