FROM openeuler/openeuler:20.03-lts

##COPY openGauss-third_party_binarylibs_openEuler_x86_64.tar.gz .
COPY cmake-3.19.5-Linux-x86_64.tar.gz .
COPY openEuler_aarch64.repo /etc/yum.repos.d/openEuler_aarch64.repo
COPY config_cmake.ini .
COPY config.ini .
COPY entrypoint_llt.sh .
COPY Private_LLT_Build.sh .
COPY Private_Main.sh .
COPY loop.sh .

ENV LANG en_US.utf8

RUN set -eux; \
    yum install -y lz4 lz4-devel bzip2 bzip2-devel curl libaio libaio-devel flex bison ncurses-devel glibc-devel patch dkms readline-devel wget \
    which git libtool-ltdl-devel autoconf libtool python3 python3-devel python python-devel openssl-devel gcc-c++ make hostname iproute dos2unix --nogpgcheck && \
    mkdir -p /usr1/build/workspace/ && \
    ln -s /usr/lib/dkms/lsb_release /usr/bin/lsb_release && \
    ## mv openGauss-third_party_binarylibs_openEuler_x86_64.tar.gz /usr1/build/workspace/openGauss-third_party_binarylibs.tar.gz && \
    mkdir /usr1/build/workspace/dependency && \
    mv cmake-3.19.5-Linux-x86_64.tar.gz /usr1/build/workspace/dependency/cmake-3.19.5-Linux.tar.gz && \
    mkdir -p /data/llt/PrivateBuild_tools/ && \
    touch /usr1/build/workspace/build.log
    
COPY loop.sh /usr/local/bin/
COPY entrypoint_llt.sh /usr/local/bin/
COPY config_cmake.ini /data/llt/PrivateBuild_tools/
COPY config.ini /data/llt/PrivateBuild_tools/
COPY entrypoint_llt.sh /data/llt/PrivateBuild_tools/
COPY Private_LLT_Build.sh /data/llt/PrivateBuild_tools/
COPY Private_Main.sh /data/llt/PrivateBuild_tools/
RUN chmod 755 /usr/local/bin/entrypoint_llt.sh
RUN chmod 755 /usr/local/bin/loop.sh


ENTRYPOINT ["/usr/local/bin/loop.sh"]

CMD ["tail -f /usr1/build/workspace/build.log"]
